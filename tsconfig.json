{
  "compilerOptions": {
    "declaration": true,
    "module": "Node16",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "target": "es2022",
    "moduleResolution": "node16",
    "composite": true
  },
  "include": ["./src/**/*"],
  "exclude": ["./test/**/*"],
  "ts-node": {
    "esm": true,
    // `tsc -b` ignores this section: the build target above stays es2022.
    // ts-node (mocha, e2e:sweep) needs es2024 to parse the `v`-flag regexes
    // eslint requires in test/ and scripts/ — at es2022 every load of
    // test/e2e/fixtures.ts dies on TS1501.
    "compilerOptions": {
      "target": "es2024"
    }
  }
}
